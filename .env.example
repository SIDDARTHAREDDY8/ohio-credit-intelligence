# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ohio_credit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ohio_credit

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=ohio_credit_risk
MLFLOW_MODEL_NAME=ohio_credit_risk

# Claude API
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_RETRIES=2            # SDK retries on 429/5xx before falling back

# API security
# Comma-separated keys accepted in the X-API-Key header. Leave blank to disable
# auth for local dev/demo; set in production to require a key on /score, /explain.
API_KEY=
SCORE_RATE_LIMIT=30/minute     # per-client rate limit on POST /score

# App
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
# Sent as X-API-Key by the frontend when the API requires auth (must match API_KEY).
VITE_API_KEY=

# AWS (deployment only — not needed for local dev)
AWS_REGION=us-east-2
ECR_REGISTRY=your_ecr_registry_url
EC2_HOST=your_ec2_public_ip
EC2_USER=ec2-user
