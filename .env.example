# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ohio_credit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ohio_credit

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=ohio_credit_risk
MLFLOW_MODEL_NAME=ohio_credit_risk

# Claude API
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# App
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# AWS (deployment only — not needed for local dev)
AWS_REGION=us-east-2
ECR_REGISTRY=your_ecr_registry_url
EC2_HOST=your_ec2_public_ip
EC2_USER=ec2-user
